{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DutyRoster",
  "version": "0.3.0",
  "identifier": "io.github.eyyuphikmet.dutyroster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Öğretmen Nöbet Çizelgesi Hazırlayıcı",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 950,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
